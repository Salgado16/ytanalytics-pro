generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  channels      UserChannel[]
  skills        Skill[]
  references    Reference[]
  mediaAssets   MediaAsset[]
  transcriptions Transcription[]
  textTools     TextTool[]
  ideas         Idea[]
  settings      UserSettings?
  apiKeys       ApiKey[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model UserChannel {
  id              String   @id @default(cuid())
  userId          String
  channelId       String   @unique
  channelTitle    String
  channelHandle   String?
  accessToken     String   @db.Text
  refreshToken    String   @db.Text
  tokenExpiry     DateTime
  isPrimary       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_channels")
}

model Skill {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String   @db.Text
  category    String
  tags        String[]
  content     String   @db.Text
  sourceUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([category])
  @@map("skills")
}

model Reference {
  id          String   @id @default(cuid())
  userId      String
  title       String
  type        String
  url         String
  thumbnail   String?
  description String?  @db.Text
  tags        String[]
  channelId   String?
  videoId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([channelId])
  @@index([videoId])
  @@map("references")
}

model MediaAsset {
  id        String   @id @default(cuid())
  userId    String
  type      String
  source    String
  sourceId  String
  url       String
  thumbnail String
  width     Int
  height    Int
  duration  Float?
  tags      String[]
  author    String?
  authorUrl String?
  license   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([source])
  @@map("media_assets")
}

model Transcription {
  id            String   @id @default(cuid())
  userId        String
  sourceType    String
  sourceUrl     String
  sourceId      String?
  language      String
  status        String   @default("pending")
  text          String?  @db.Text
  segments      Json?
  error         String?
  createdAt     DateTime @default(now())
  completedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("transcriptions")
}

model TextTool {
  id        String   @id @default(cuid())
  userId    String
  type      String
  input     String   @db.Text
  output    String   @db.Text
  settings  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("text_tools")
}

model Idea {
  id                String    @id @default(cuid())
  userId            String
  title             String
  description       String    @db.Text
  status            String    @default("backlog")
  priority          String    @default("medium")
  tags              String[]
  targetKeywords    String[]
  estimatedDuration Int?
  thumbnailIdeas    String[]
  references        String[]
  scheduledAt       DateTime?
  publishedAt       DateTime?
  videoId           String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("ideas")
}

model UserSettings {
  id             String   @id @default(cuid())
  userId         String   @unique
  youtubeConnected Boolean @default(false)
  youtubeChannelId String?
  defaultLanguage String   @default("pt-BR")
  ttsVoice       String?
  theme          String   @default("system")
  notifications  Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model ApiKey {
  id        String   @id @default(cuid())
  userId    String
  provider  String
  key       String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@map("api_keys")
}

model ChannelAnalytics {
  id                    String   @id @default(cuid())
  channelId             String
  date                  DateTime @db.Date
  views                 Int
  subscribersGained     Int
  subscribersLost       Int
  estimatedMinutesWatched Int
  averageViewDuration   Float
  averageViewPercentage Float
  revenue               Float?
  rpm                   Float?
  impressions           Int?
  ctr                   Float?
  createdAt             DateTime @default(now())

  @@unique([channelId, date])
  @@index([channelId])
  @@index([date])
  @@map("channel_analytics")
}

model VideoAnalytics {
  id                    String   @id @default(cuid())
  videoId               String
  channelId             String
  date                  DateTime @db.Date
  views                 Int
  estimatedMinutesWatched Int
  averageViewDuration   Float
  averageViewPercentage Float
  subscribersGained     Int
  subscribersLost       Int
  likes                 Int
  dislikes              Int
  comments              Int
  shares                Int
  impressions           Int?
  ctr                   Float?
  revenue               Float?
  rpm                   Float?
  createdAt             DateTime @default(now())

  @@unique([videoId, date])
  @@index([videoId])
  @@index([channelId])
  @@index([date])
  @@map("video_analytics")
}

model NicheChannel {
  id                String   @id @default(cuid())
  channelId         String   @unique
  title             String
  description       String   @db.Text
  subscriberCount   Int
  viewCount         Int
  videoCount        Int
  country           String?
  topicCategories   String[]
  growthRate        Float
  viralScore        Float
  avgViewsPerVideo  Float
  uploadFrequency   Float
  lastUploadAt      DateTime
  thumbnails        Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([growthRate])
  @@index([viralScore])
  @@index([subscriberCount])
  @@map("niche_channels")
}

model ViralVideo {
  id            String   @id @default(cuid())
  videoId       String   @unique
  channelId     String
  channelTitle  String
  title         String
  description   String   @db.Text
  publishedAt   DateTime
  thumbnails    Json
  viewCount     Int
  likeCount     Int
  commentCount  Int
  duration      String
  tags          String[]
  categoryId    String
  viralScore    Float
  velocity      Float
  trendScore    Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([viralScore])
  @@index([velocity])
  @@index([trendScore])
  @@index([publishedAt])
  @@index([channelId])
  @@map("viral_videos")
}