# Database (use esta se rodar PostgreSQL via Docker: docker run -d --name postgres -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=ytanalytics_pro -p 5432:5432 postgres:15)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ytanalytics_pro?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="gere-um-valor-aleatorio"

# Google OAuth (Google Cloud Console → APIs → YouTube Data API v3 + YouTube Analytics API → Credentials → OAuth 2.0)
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="seu-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="seu-google-client-secret"

# YouTube API (Google Cloud Console → APIs → YouTube Data API v3 → Credentials → API Key)
YOUTUBE_API_KEY="sua-youtube-api-key"

# Pixabay API (https://pixabay.com/api/docs/)
PIXABAY_API_KEY="sua-pixabay-api-key"

# Pexels API (https://www.pexels.com/api/documentation/)
PEXELS_API_KEY="sua-pexels-api-key"

# OpenAI API (opcional - para IA titles/hashtags) - https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-sua-openai-key"

# ElevenLabs API (opcional - TTS premium) - https://elevenlabs.io/api
ELEVENLABS_API_KEY="sua-elevenlabs-key"

# AssemblyAI API (opcional - transcrição precisa) - https://www.assemblyai.com/docs/
ASSEMBLYAI_API_KEY="sua-assemblyai-key"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"